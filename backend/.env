# Server Port
PORT=5000

# Database Engine: 'auto', 'mysql', or 'sqlite'
# If set to 'auto', it connects to MySQL if reachable, otherwise automatically falls back to local SQLite
DB_TYPE=auto

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doctor_appointment_db

# JWT Secret Key
JWT_SECRET=super-secret-doctor-appointment-key-2026
